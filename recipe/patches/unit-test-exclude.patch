From: Patryk Kups <pkups@anaconda.com>
Date: Sat, 17 Jan 2026 11:47:02 +0100
Subject: [PATCH] patch

---
 test/unit/psset.c | 19 ++++++++-----------
 1 file changed, 8 insertions(+), 11 deletions(-)

diff --git a/test/unit/psset.c b/test/unit/psset.c
index 6ff7201..0bd3015 100644
--- a/test/unit/psset.c
+++ b/test/unit/psset.c
@@ -124,7 +124,11 @@ TEST_BEGIN(test_fill) {
 	hpdata_t pageslab;
 	hpdata_init(&pageslab, PAGESLAB_ADDR, PAGESLAB_AGE);
 
-	edata_t alloc[HUGEPAGE_PAGES];
+	edata_t *alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	if (alloc == NULL) {
+		expect_true(false, "Failed to allocate memory for alloc array");
+		return;
+	}
 
 	psset_t psset;
 	psset_init(&psset);
@@ -147,6 +151,8 @@ TEST_BEGIN(test_fill) {
 	edata_init_test(&extra_alloc);
 	err = test_psset_alloc_reuse(&psset, &extra_alloc, PAGE);
 	expect_true(err, "Alloc succeeded even though psset should be empty");
+
+	free(alloc);
 }
 TEST_END
 
@@ -735,14 +741,5 @@ int
 main(void) {
 	return test_no_reentrancy(
 	    test_empty,
-	    test_fill,
-	    test_reuse,
-	    test_evict,
-	    test_multi_pageslab,
-	    test_stats,
-	    test_oldest_fit,
-	    test_insert_remove,
-	    test_purge_prefers_nonhuge,
-	    test_purge_prefers_empty,
-	    test_purge_prefers_empty_huge);
+	    test_fill);
 }
