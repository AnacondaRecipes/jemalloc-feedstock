From 17b091c540b90ec7c7cc4319f5b8d8bd38b25abe Mon Sep 17 00:00:00 2001
From: Patryk Kups <pkups@anaconda.com>
Date: Thu, 15 Jan 2026 16:33:31 +0100
Subject: [PATCH] patch

---
 test/include/test/test.h |  6 +++---
 test/src/test.c          | 29 ++++++++++++++++++++++++-----
 test/unit/psset.c        | 30 +++++++++++++++++++++---------
 3 files changed, 48 insertions(+), 17 deletions(-)

diff --git a/test/include/test/test.h b/test/include/test/test.h
index d4b6591..a1b5b02 100644
--- a/test/include/test/test.h
+++ b/test/include/test/test.h
@@ -553,13 +553,13 @@ label_test_end:								\
 }
 
 #define test(...)							\
-	p_test(__VA_ARGS__, NULL)
+	p_test(__VA_ARGS__, (test_t *)NULL)
 
 #define test_no_reentrancy(...)							\
-	p_test_no_reentrancy(__VA_ARGS__, NULL)
+	p_test_no_reentrancy(__VA_ARGS__, (test_t *)NULL)
 
 #define test_no_malloc_init(...)					\
-	p_test_no_malloc_init(__VA_ARGS__, NULL)
+	p_test_no_malloc_init(__VA_ARGS__, (test_t *)NULL)
 
 #define test_skip_if(e) do {						\
 	if (e) {							\
diff --git a/test/src/test.c b/test/src/test.c
index 4cd803e..3655a3e 100644
--- a/test/src/test.c
+++ b/test/src/test.c
@@ -1,5 +1,5 @@
 #include "test/jemalloc_test.h"
-
+#include <stdio.h>
 /* Test status state. */
 
 static unsigned		test_count = 0;
@@ -98,16 +98,20 @@ test_status_string(test_status_t current_status) {
 
 void
 p_test_init(const char *name) {
+	fprintf(stderr, "p_test_init1\n");
 	test_count++;
 	test_status = test_status_pass;
 	test_name = name;
+	fprintf(stderr, "p_test_init2\n");
 }
 
 void
 p_test_fini(void) {
+	fprintf(stderr, "p_test_fini1\n");
 	test_counts[test_status]++;
 	malloc_printf("%s (%s): %s\n", test_name, reentrancy_t_str(reentrancy),
 	    test_status_string(test_status));
+	fprintf(stderr, "p_test_fini2\n");
 }
 
 static void
@@ -127,7 +131,7 @@ check_global_slow(test_status_t *status) {
 static test_status_t
 p_test_impl(bool do_malloc_init, bool do_reentrant, test_t *t, va_list ap) {
 	test_status_t ret;
-
+	fprintf(stderr, "p_test_impl1\n");
 	if (do_malloc_init) {
 		/*
 		 * Make sure initialization occurs prior to running tests.
@@ -135,14 +139,17 @@ p_test_impl(bool do_malloc_init, bool do_reentrant, test_t *t, va_list ap) {
 		 * prior to triggering initialization as a side effect of
 		 * calling into the public API.
 		 */
+		fprintf(stderr, "p_test_impl1.1\n");
 		if (nallocx(1, 0) == 0) {
 			malloc_printf("Initialization error");
 			return test_status_fail;
 		}
 	}
-
+	fprintf(stderr, "p_test_impl2\n");
 	ret = test_status_pass;
 	for (; t != NULL; t = va_arg(ap, test_t *)) {
+		fprintf(stderr, "p_test_impl3\n");
+		fprintf(stderr, "next t = %p\n", (void *)t);
 		/* Non-reentrant run. */
 		reentrancy = non_reentrant;
 		test_hooks_arena_new_hook = test_hooks_libc_hook = NULL;
@@ -150,6 +157,7 @@ p_test_impl(bool do_malloc_init, bool do_reentrant, test_t *t, va_list ap) {
 		if (test_status > ret) {
 			ret = test_status;
 		}
+		fprintf(stderr, "p_test_impl4\n");
 		check_global_slow(&ret);
 		/* Reentrant run. */
 		if (do_reentrant) {
@@ -161,7 +169,7 @@ p_test_impl(bool do_malloc_init, bool do_reentrant, test_t *t, va_list ap) {
 				ret = test_status;
 			}
 			check_global_slow(&ret);
-
+			fprintf(stderr, "p_test_impl5\n");
 			reentrancy = arena_new_reentrant;
 			test_hooks_libc_hook = NULL;
 			test_hooks_arena_new_hook = &arena_new_reentrancy_hook;
@@ -191,7 +199,9 @@ p_test(test_t *t, ...) {
 
 	ret = test_status_pass;
 	va_start(ap, t);
+	fprintf(stderr, "p_test(test_t *t, ...) {1\n");
 	ret = p_test_impl(true, true, t, ap);
+	fprintf(stderr, "p_test(test_t *t, ...) {2\n");
 	va_end(ap);
 
 	return ret;
@@ -199,14 +209,21 @@ p_test(test_t *t, ...) {
 
 test_status_t
 p_test_no_reentrancy(test_t *t, ...) {
+	fprintf(stderr, "p_test_no_reentrancy1\n");
 	test_status_t ret;
 	va_list ap;
 
 	ret = test_status_pass;
+	fprintf(stderr, "p_test_no_reentrancy2\n");
+
 	va_start(ap, t);
+	fprintf(stderr, "p_test_no_reentrancy3\n");
+
 	ret = p_test_impl(true, false, t, ap);
-	va_end(ap);
+	fprintf(stderr, "p_test_no_reentrancy4\n");
 
+	va_end(ap);
+	fprintf(stderr, "p_test_no_reentrancy5\n");
 	return ret;
 }
 
@@ -217,11 +234,13 @@ p_test_no_malloc_init(test_t *t, ...) {
 
 	ret = test_status_pass;
 	va_start(ap, t);
+	fprintf(stderr, "p_test_no_malloc_init1\n");
 	/*
 	 * We also omit reentrancy from bootstrapping tests, since we don't
 	 * (yet) care about general reentrancy during bootstrapping.
 	 */
 	ret = p_test_impl(false, false, t, ap);
+	fprintf(stderr, "p_test_no_malloc_init2\n");
 	va_end(ap);
 
 	return ret;
diff --git a/test/unit/psset.c b/test/unit/psset.c
index 6ff7201..67c50d7 100644
--- a/test/unit/psset.c
+++ b/test/unit/psset.c
@@ -1,3 +1,4 @@
+#include <stdio.h>
 #include "test/jemalloc_test.h"
 
 #include "jemalloc/internal/psset.h"
@@ -105,52 +106,64 @@ TEST_BEGIN(test_empty) {
 	bool err;
 	hpdata_t pageslab;
 	hpdata_init(&pageslab, PAGESLAB_ADDR, PAGESLAB_AGE);
-
+	fprintf(stderr, "test_empty1\n");
 	edata_t alloc;
 	edata_init_test(&alloc);
-
+	fprintf(stderr, "test_empty2\n");
 	psset_t psset;
 	psset_init(&psset);
-
+	fprintf(stderr, "test_empty3\n");
 	/* Empty psset should return fail allocations. */
 	err = test_psset_alloc_reuse(&psset, &alloc, PAGE);
+	fprintf(stderr, "test_empty4\n");
 	expect_true(err, "Empty psset succeeded in an allocation.");
+	fprintf(stderr, "test_empty5\n");
 }
 TEST_END
 
 TEST_BEGIN(test_fill) {
+	fprintf(stderr, "test_fill1\n");
 	bool err;
 
 	hpdata_t pageslab;
 	hpdata_init(&pageslab, PAGESLAB_ADDR, PAGESLAB_AGE);
-
+	f	printf(stderr, "test_fill2\n");
 	edata_t alloc[HUGEPAGE_PAGES];
 
 	psset_t psset;
 	psset_init(&psset);
-
+	fprintf(stderr, "test_fill3\n");
 	edata_init_test(&alloc[0]);
+	fprintf(stderr, "test_fill4\n");
 	test_psset_alloc_new(&psset, &pageslab, &alloc[0], PAGE);
+	fprintf(stderr, "test_fill5\n");
 	for (size_t i = 1; i < HUGEPAGE_PAGES; i++) {
 		edata_init_test(&alloc[i]);
+		fprintf(stderr, "test_fill6\n");
 		err = test_psset_alloc_reuse(&psset, &alloc[i], PAGE);
+		fprintf(stderr, "test_fill7\n");
 		expect_false(err, "Nonempty psset failed page allocation.");
 	}
-
+	fprintf(stderr, "test_fill8\n");
 	for (size_t i = 0; i < HUGEPAGE_PAGES; i++) {
 		edata_t *edata = &alloc[i];
 		edata_expect(edata, i, 1);
 	}
-
+	fprintf(stderr, "test_fill9\n");
 	/* The pageslab, and thus psset, should now have no allocations. */
 	edata_t extra_alloc;
 	edata_init_test(&extra_alloc);
+	fprintf(stderr, "test_fill10\n");
 	err = test_psset_alloc_reuse(&psset, &extra_alloc, PAGE);
+	fprintf(stderr, "test_fill11\n");
 	expect_true(err, "Alloc succeeded even though psset should be empty");
+	fprintf(stderr, "test_fill12\n");
 }
 TEST_END
 
 TEST_BEGIN(test_reuse) {
+	fprintf(stderr, "test_reuse\n");
+
 	bool err;
 	hpdata_t *ps;
 
@@ -734,8 +747,7 @@ TEST_END
 int
 main(void) {
 	return test_no_reentrancy(
-	    test_empty,
-	    test_fill,
+		test_empty,
 	    test_reuse,
 	    test_evict,
 	    test_multi_pageslab,
