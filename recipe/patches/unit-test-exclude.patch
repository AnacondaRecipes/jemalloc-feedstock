From: Patryk Kups <pkups@anaconda.com>
Date: Sat, 17 Jan 2026 12:08:05 +0100
Subject: [PATCH] patch

---
 test/unit/psset.c | 49 ++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 40 insertions(+), 9 deletions(-)

diff --git a/test/unit/psset.c b/test/unit/psset.c
index 6ff7201..4385888 100644
--- a/test/unit/psset.c
+++ b/test/unit/psset.c
@@ -124,7 +124,8 @@ TEST_BEGIN(test_fill) {
 	hpdata_t pageslab;
 	hpdata_init(&pageslab, PAGESLAB_ADDR, PAGESLAB_AGE);
 
-	edata_t alloc[HUGEPAGE_PAGES];
+	edata_t *alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(alloc, "Failed to allocate memory for alloc array");
 
 	psset_t psset;
 	psset_init(&psset);
@@ -147,6 +148,8 @@ TEST_BEGIN(test_fill) {
 	edata_init_test(&extra_alloc);
 	err = test_psset_alloc_reuse(&psset, &extra_alloc, PAGE);
 	expect_true(err, "Alloc succeeded even though psset should be empty");
+
+	free(alloc);
 }
 TEST_END
 
@@ -157,7 +160,8 @@ TEST_BEGIN(test_reuse) {
 	hpdata_t pageslab;
 	hpdata_init(&pageslab, PAGESLAB_ADDR, PAGESLAB_AGE);
 
-	edata_t alloc[HUGEPAGE_PAGES];
+	edata_t *alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(alloc, "Failed to allocate memory for alloc array");
 
 	psset_t psset;
 	psset_init(&psset);
@@ -239,6 +243,8 @@ TEST_BEGIN(test_reuse) {
 	err = test_psset_alloc_reuse(&psset, &alloc[index_of_4], 4 * PAGE);
 	expect_false(err, "Should have been able to find alloc.");
 	edata_expect(&alloc[index_of_4], index_of_4, 4);
+
+	free(alloc);
 }
 TEST_END
 
@@ -249,7 +255,8 @@ TEST_BEGIN(test_evict) {
 	hpdata_t pageslab;
 	hpdata_init(&pageslab, PAGESLAB_ADDR, PAGESLAB_AGE);
 
-	edata_t alloc[HUGEPAGE_PAGES];
+	edata_t *alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(alloc, "Failed to allocate memory for alloc array");
 
 	psset_t psset;
 	psset_init(&psset);
@@ -273,6 +280,8 @@ TEST_BEGIN(test_evict) {
 
 	err = test_psset_alloc_reuse(&psset, &alloc[0], PAGE);
 	expect_true(err, "psset should be empty.");
+
+	free(alloc);
 }
 TEST_END
 
@@ -286,7 +295,12 @@ TEST_BEGIN(test_multi_pageslab) {
 	    (void *)((uintptr_t)PAGESLAB_ADDR + HUGEPAGE),
 	    PAGESLAB_AGE + 1);
 
-	edata_t alloc[2][HUGEPAGE_PAGES];
+	edata_t **alloc = (edata_t **)malloc(2 * sizeof(edata_t *));
+	expect_ptr_not_null(alloc, "Failed to allocate memory for alloc array");
+	alloc[0] = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	alloc[1] = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(alloc[0], "Failed to allocate memory for alloc[0]");
+	expect_ptr_not_null(alloc[1], "Failed to allocate memory for alloc[1]");
 
 	psset_t psset;
 	psset_init(&psset);
@@ -336,6 +350,10 @@ TEST_BEGIN(test_multi_pageslab) {
 	 */
 	err = test_psset_alloc_reuse(&psset, &alloc[1][0], 2 * PAGE);
 	expect_false(err, "Allocation should have succeeded");
+
+	free(alloc[0]);
+	free(alloc[1]);
+	free(alloc);
 }
 TEST_END
 
@@ -385,7 +403,8 @@ TEST_BEGIN(test_stats) {
 	hpdata_t pageslab;
 	hpdata_init(&pageslab, PAGESLAB_ADDR, PAGESLAB_AGE);
 
-	edata_t alloc[HUGEPAGE_PAGES];
+	edata_t *alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(alloc, "Failed to allocate memory for alloc array");
 
 	psset_t psset;
 	psset_init(&psset);
@@ -415,6 +434,8 @@ TEST_BEGIN(test_stats) {
 	stats_expect(&psset, 0);
 	psset_update_end(&psset, &pageslab);
 	stats_expect(&psset, 1);
+
+	free(alloc);
 }
 TEST_END
 
@@ -475,8 +496,10 @@ init_test_pageslabs(psset_t *psset, hpdata_t *pageslab,
 
 TEST_BEGIN(test_oldest_fit) {
 	bool err;
-	edata_t alloc[HUGEPAGE_PAGES];
-	edata_t worse_alloc[HUGEPAGE_PAGES];
+	edata_t *alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(alloc, "Failed to allocate memory for alloc array");
+	edata_t *worse_alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(worse_alloc, "Failed to allocate memory for alloc array");
 
 	hpdata_t pageslab;
 	hpdata_t worse_pageslab;
@@ -493,14 +516,19 @@ TEST_BEGIN(test_oldest_fit) {
 	expect_false(err, "Nonempty psset failed page allocation");
 	expect_ptr_eq(&pageslab, edata_ps_get(&test_edata),
 	    "Allocated from the wrong pageslab");
+
+	free(alloc);
+	free(worse_alloc);
 }
 TEST_END
 
 TEST_BEGIN(test_insert_remove) {
 	bool err;
 	hpdata_t *ps;
-	edata_t alloc[HUGEPAGE_PAGES];
-	edata_t worse_alloc[HUGEPAGE_PAGES];
+	edata_t *alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(alloc, "Failed to allocate memory for alloc array");
+	edata_t *worse_alloc = (edata_t *)malloc(HUGEPAGE_PAGES * sizeof(edata_t));
+	expect_ptr_not_null(worse_alloc, "Failed to allocate memory for alloc array");
 
 	hpdata_t pageslab;
 	hpdata_t worse_pageslab;
@@ -539,6 +567,9 @@ TEST_BEGIN(test_insert_remove) {
 	psset_update_begin(&psset, &worse_pageslab);
 	err = test_psset_alloc_reuse(&psset, &alloc[HUGEPAGE_PAGES - 1], PAGE);
 	expect_true(err, "psset should be empty, but an alloc succeeded");
+
+	free(alloc);
+	free(worse_alloc);
 }
 TEST_END
 
